#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen {
        zmk,matrix_transform = &default_transform;

        // zmk,matrix_transform = &five_column_transform;
    };
};

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD0";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        lt100ms: lt100ms {
            compatible = "zmk,behavior-hold-tap";
            label = "LT100MS";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <100>;
        };

        lt200ms: lt200ms {
            compatible = "zmk,behavior-hold-tap";
            label = "LT200MS";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        mtz200ms: mtz200ms {
            compatible = "zmk,behavior-hold-tap";
            label = "MTZ200MS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    macros {
        format_code: format_code {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "FORMAT_CODE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   | 
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&sl 5           &kp Q                   &kp W                 &kp E                     &kp R                   &kp T               &kp Y             &kp U                    &kp I              &kp O                  &kp P                 &kp C_MUTE
&kp LS(C_NEXT)  &kp A                   &mtz200ms LEFT_ALT S  &mtz200ms LEFT_CONTROL D  &mtz200ms LEFT_SHIFT F  &kp G               &kp H             &mtz200ms RIGHT_SHIFT J  &mtz200ms RCTRL K  &mtz200ms RIGHT_ALT L  &kp SEMICOLON         &kp C_VOLUME_UP
&kp K_PREVIOUS  &mtz200ms LEFT_SHIFT Z  &kp X                 &kp C                     &kp V                   &kp B               &kp N             &kp M                    &kp COMMA          &mt RIGHT_ALT PERIOD   &mt RIGHT_SHIFT FSLH  &kp K_VOLUME_DOWN
                                                              &mtz200ms LCTRL ESCAPE    &lt100ms 1 TAB          &lt100ms 3 ENTER    &lt200ms 3 SPACE  &lt100ms 2 BACKSPACE     &kp RALT
            >;
        };

        lower_layer {
            display-name = "NUMBER";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp N5           &kp TILDE        &kp LG(L)    &kp LS(LA(F))  &kp BACKSPACE   &kp DELETE         &kp GRAVE         &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &kp F11               &kp F12                &kp N6
&bt BT_SEL 3     &kp EXCLAMATION  &kp AT_SIGN  &kp HASH       &kp DOLLAR      &kp PERCENT        &kp CARET         &kp AMPS           &kp ASTRK         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT
&rgb_ug RGB_EFF  &kp EQUAL        &kp MINUS    &kp PLUS       &kp LEFT_BRACE  &kp RIGHT_BRACE    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SEMICOLON     &kp COLON             &kp BACKSLASH          &kp LEFT_BRACKET
                                               &trans         &trans          &trans             &trans            &trans             &trans
            >;
        };

        raise_layer {
            display-name = "SYMBOL";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &trans          &trans        &trans     &trans          &trans       &kp PIPE        &kp BACKSLASH         &kp UP_ARROW      &trans           &trans           &trans
&none   &kp LEFT_WIN    &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &kp TAB      &kp QUESTION    &kp LEFT_ARROW        &kp DOWN_ARROW    &kp RIGHT_ARROW  &kp DELETE       &kp MINUS
&none   &kp LEFT_SHIFT  &trans        &trans     &trans          &trans       &kp UNDERSCORE  &kp EQUAL             &kp GREATER_THAN  &kp LEFT_BRACE   &kp RIGHT_BRACE  &kp UNDER
                                      &trans     &trans          &kp SPACE    &kp RET         &lt200ms 2 BACKSPACE  &trans
            >;
        };

        layer_3 {
            display-name = "Fn";
            bindings = <
&kp F5       &trans        &kp F7  &kp F8  &kp F9  &kp F10    &kp F7        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS     &kp F6
&bootloader  &kp LEFT_WIN  &kp F4  &kp F5  &kp F6  &kp F11    &kp DOT       &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS      &bootloader
&trans       &kp LEFT_ALT  &kp F1  &kp F2  &kp F3  &kp F12    &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_ENTER  &trans
                                   &trans  &trans  &trans     &trans        &trans        &trans
            >;
        };

        layer_4 {
            bindings = <
&trans          &rgb_ug RGB_TOG  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &rgb_ug RGB_EFF  &rgb_ug RGB_COLOR_HSB(292,100,50)    &kp C_PLAY_PAUSE  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOLUME_UP  &trans  &trans
&bt BT_CLR_ALL  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                         &kp CAPSLOCK      &trans      &trans        &trans           &trans  &trans
&trans          &bl BL_TOG       &bl BL_INC       &bl BL_DEC       &rgb_ug RGB_BRI  &rgb_ug RGB_BRD                      &kp INS           &trans      &trans        &trans           &trans  &trans
                                                  &trans           &trans           &trans                               &trans            &trans      &trans
            >;
        };

        layer_5 {
            display-name = "GAME";
            bindings = <
&kp TAB     &kp Q  &kp W  &kp E     &kp R         &kp T        &kp Y      &kp U                    &kp I              &kp O                  &kp P                 &sl 0
&kp LSHIFT  &kp A  &kp S  &kp D     &kp F         &kp G        &kp H      &mtz200ms RIGHT_SHIFT J  &mtz200ms RCTRL K  &mtz200ms RIGHT_ALT L  &kp SEMICOLON         &lt 4 RIGHT_WIN
&kp LCTRL   &kp Z  &kp X  &kp C     &kp V         &kp B        &kp N      &kp M                    &kp COMMA          &mt RIGHT_ALT PERIOD   &mt RIGHT_SHIFT FSLH  &kp ESC
                          &kp LGUI  &kp LEFT_ALT  &kp SPACE    &kp SPACE  &lt100ms 2 BACKSPACE     &kp RALT
            >;
        };
    };
};
